# Postgres + pgvector (docker compose dev default; see docs/BUILD_PLAN.md 2.1)
DATABASE_URL=postgres://ambit:ambit@localhost:5432/ambit

# Auth.js (generate secret: `openssl rand -base64 32`)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Magic-link mail — Mailpit catches mail in dev (no key); Resend in prod
RESEND_API_KEY=

# Embeddings — only needed if Phase 0 picks OpenAI text-embedding-3-small
OPENAI_API_KEY=

