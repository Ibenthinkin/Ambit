# Postgres — plain, no pgvector (docker compose dev default; see docs/BUILD_PLAN.md 2.1)
DATABASE_URL=postgres://ambit:ambit@localhost:5432/ambit

# Better Auth (generate secret: `openssl rand -base64 32`)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Transactional mail (password reset) — Mailpit catches mail in dev (no key); Resend in prod
RESEND_API_KEY=

# OpenRouter gateway (SPEC §6.2) — the ingest-time LLM curator + offline embedding
# tooling (topic-graph recomputes). Never on the request path.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Voyage AI — visual (image) embeddings experiment only (phase0/embed-images.ts;
# SPEC §15 open question). Free key at https://dash.voyageai.com
VOYAGE_API_KEY=

# Feed engine dev affordances (SPEC §9) — debug overlay data + ad hoc knob overrides on
# feed.page. Optional: unset defaults to "on" in development, "off" otherwise.
FEED_DEBUG=

# Personal archive service (Phase A.5; the ambit-archive repo) — ingest-only, never on the
# request path. ARCHIVE_URL is the service origin (dev: http://localhost:3001); ARCHIVE_API_KEY
# is the shared x-archive-key secret, copied from ambit-archive's own .env.
# Both optional: leave them unset and the archive source is simply unavailable to ingest.
ARCHIVE_URL=
ARCHIVE_API_KEY=

# Smithsonian Open Access (Phase 6.2 trial) — free key, instant signup at
# https://api.data.gov/signup/ . Ingest-only; raises the rate limit from DEMO_KEY's 10/hr to
# 1,000/hr (verified live 08-21-26 via the x-ratelimit-limit header).
SMITHSONIAN_API_KEY=
