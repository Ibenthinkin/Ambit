{
  "name": "ambit-scaffold",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --bun next build",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run scripts/seed-topics.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "bun run --bun next dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "ingest": "bun run scripts/ingest.ts",
    "retire": "bun run scripts/retire-source-rows.ts",
    "invite": "bun run scripts/invite.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "next build && next start",
    "recurate": "bun run scripts/recurate.ts",
    "probe": "bun run scripts/probe-adapter.ts",
    "probe:feed": "bun run scripts/probe-feed.ts",
    "probe:walk": "bun run scripts/probe-walk.ts",
    "start": "bun run --bun next start",
    "e2e": "playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.12.0",
    "@tanstack/react-query": "5.101.4",
    "@trpc/client": "11.18.0",
    "@trpc/react-query": "11.18.0",
    "@trpc/server": "11.18.0",
    "better-auth": "^1.6",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.2",
    "nanoid": "^6.0.0",
    "next": "16.2.12",
    "nodemailer": "^9.0.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "0.0.1",
    "superjson": "2.2.6",
    "tailwind-merge": "3.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.19.43",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-drizzle": "0.2.3",
    "jsdom": "^30.0.1",
    "postcss": "8.5.24",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.6.14",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  },
  "trustedDependencies": [
    "@swc/core",
    "unrs-resolver"
  ]
}
